---
import { app, site } from "../data/site";

interface Props {
  path: string;
}

const { path } = Astro.props;

const links = [
  { href: "/", label: "Home", match: "/" },
  { href: "/#product", label: "Product", match: "" },
  { href: "/pricing", label: "Pricing", match: "/pricing" },
  { href: "/support", label: "Support", match: "/support" },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="AgentOS home">
    <img src="/brand/wordmark-on-dark.png" alt="AgentOS" width="220" height="68" />
  </a>

  <nav class="nav-desktop" aria-label="Primary">
    {links.filter((link) => link.href !== "/").map((link) => (
      <a href={link.href} aria-current={path === link.match ? "page" : undefined}>
        {link.label}
      </a>
    ))}
    <a href={app.login}>Log in</a>
    <a class="btn header-cta" href={app.signup}>Get started</a>
  </nav>

  <button type="button" class="menu-toggle" id="menuOpen" aria-haspopup="dialog" aria-controls="navDialog">
    Menu
  </button>
</header>

<dialog class="nav-dialog" id="navDialog" aria-label="Menu">
  <div class="nav-dialog-bar">
    <a class="brand" href="/" aria-label="AgentOS home">
      <img src="/brand/wordmark-on-dark.png" alt="AgentOS" width="220" height="68" />
    </a>
    <button type="button" class="menu-toggle" data-close>Close</button>
  </div>
  <nav class="nav-sheet" aria-label="Mobile">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a href="/#who">Who it's for</a>
    <a href="/marketplace">Marketplace</a>
    <a href={app.login}>Log in</a>
    <a href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
    <a class="btn" href={app.signup}>Get started</a>
  </nav>
</dialog>

<script>
  const dialog = document.getElementById("navDialog");
  const openBtn = document.getElementById("menuOpen");
  if (dialog instanceof HTMLDialogElement && openBtn) {
    const close = () => dialog.close();
    openBtn.addEventListener("click", () => dialog.showModal());
    dialog.querySelectorAll("[data-close]").forEach((el) => {
      el.addEventListener("click", close);
    });
    dialog.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", close);
    });
  }
</script>

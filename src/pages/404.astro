---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found | AgentOS"
  description="That page is not on AgentOS."
  path="/404"
  dock={false}
>
  <section class="lost wrap">
    <h1>That page is not here.</h1>
    <p class="lede">It may have moved, or the link is wrong.</p>
    <div class="btn-row">
      <a class="btn" href="/">Go home</a>
      <a class="btn btn-ghost" href="/support">Contact support</a>
    </div>
  </section>
</Base>

---
import "@fontsource-variable/bricolage-grotesque";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { app, site } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  path?: string;
  dock?: boolean;
}

const {
  title,
  description = site.description,
  path = "/",
  dock = true,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const og = new URL("/brand/og.jpg", site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#141c26" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {dock && (
      <nav class="dock" aria-label="Quick actions">
        <a class="btn" href={app.signup}>Get started</a>
        <a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>Call</a>
      </nav>
    )}
  </body>
</html>
